# Copy this file to .env and adjust values. .env is gitignored.
# The backend reads these through backend/src/profile_rag/settings.py.

# Postgres runs in Docker (compose.yaml), published on 127.0.0.1:DB_PORT.
# Port 5443 avoids clashing with other local Postgres instances on 5432.
# docker compose reads COMPOSE_PROJECT_NAME and DB_PORT from this file. The
# project name names the container and the data volume, so a second checkout
# needs its own name and port to get its own database. When you change
# DB_PORT, use the same port in DATABASE_URL and TEST_DATABASE_URL.
COMPOSE_PROJECT_NAME=profile-rag-app
DB_PORT=5443
DATABASE_URL=postgresql://profile_rag:profile_rag@127.0.0.1:5443/profile_rag

# Tests use a separate database created by db/init/01-test-db.sql.
TEST_DATABASE_URL=postgresql://profile_rag:profile_rag@127.0.0.1:5443/profile_rag_test

# Ollama runs natively on the host and serves the embedding models.
OLLAMA_URL=http://127.0.0.1:11434

# Pi (https://pi.dev) runs the answer model for `profile-rag ask`.
# PROFILE_RAG_PI_BIN is a command on PATH or a path to the executable.
# PROFILE_RAG_PI_MODEL is a Pi model ID (provider/model); Pi must already have
# credentials for its provider. Tested with Pi 1.5.0. The PROFILE_RAG_ prefix
# avoids PI_MODEL, which Pi exports to every command it runs.
PROFILE_RAG_PI_BIN=pi
PROFILE_RAG_PI_MODEL=anthropic/claude-opus-5-5
PROFILE_RAG_PI_TIMEOUT_SECONDS=120

# The search behind POST /api/ask: the embedding model (a key in
# vectorstore/models.py), and the retriever mode (dense, hybrid, or mmr) and
# k used when a request does not set them.
PROFILE_RAG_API_MODEL=nomic-v15
PROFILE_RAG_API_MODE=hybrid
PROFILE_RAG_API_K=8

# Ports on 127.0.0.1 for `make demo`, `make backend`, and `make frontend`.
API_PORT=8000
FRONTEND_PORT=5173

# The level of the API's own log lines (DEBUG, INFO, WARNING, ERROR, or
# CRITICAL). They hold request IDs and error codes, never question or answer text.
PROFILE_RAG_LOG_LEVEL=INFO

# LangSmith tracing is off unless LANGSMITH_TRACING=true. When on, every
# command refuses to start unless CORPUS_DIR=corpus-example is set in the
# environment and LANGSMITH_API_KEY is set; traces then hold no inputs,
# outputs, metadata, or error text. See "Tracing" in docs/ARCHITECTURE.md.
# These names have no PROFILE_RAG_ prefix: the langsmith library reads them.
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
